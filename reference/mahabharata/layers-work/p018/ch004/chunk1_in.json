  "lines_deva": [
   "ददर्श तत्र गोविन्दं ब्राह्मेण वपुषान्वितम्",
   "तेनैव दृष्टपूर्वेण सादृश्येनोपसूचितम्"
  ],
  "lines_iast": [
   "dadarśa tatra govindaṃ brāhmeṇa vapuṣānvitam",
   "tenaiva dṛṣṭapūrveṇa sādṛśyenopasūcitam"
  ],
